  decide +kernel

theorem permutations_bijective : Function.Bijective permutations := by
  apply (Fintype.bijective_iff_injective_and_card _).mpr
  refine ⟨?_, ?_⟩
  · intro a b h
    apply permutationMap_injective
    exact congrArg Equiv.toFun h
  · norm_num [Fintype.card_perm, Nat.factorial]

noncomputable def permutationEquiv : Fin 120 ≃ Equiv.Perm (Fin 5) :=
  Equiv.ofBijective permutations permutations_bijective

