theorem gram_entries : ∀ i j,
    (factor : ℤ) * A i j = ∑ k, W i k * (c k : ℤ) * W j k := by
  intro i j
  have h := List.all_eq_true.mp (all_rows_checked i) j (by simp)
  exact of_decide_eq_true h

noncomputable def R : Matrix (Fin 55) (Fin 55) ℚ := fun i j => (A i j : ℚ) / scale

theorem R_posSemidef : R.PosSemidef :=
  posSemidef_of_integer_gram A W c scale factor scale_positive factor_positive gram_entries

noncomputable def Q : Matrix (Fin 64) (Fin 64) ℚ := B * R * B.transpose

theorem Q_posSemidef : Q.PosSemidef :=
  posSemidef_basis R B R_posSemidef

noncomputable def Rreal : Matrix (Fin 55) (Fin 55) ℝ :=
  fun i j => (A i j : ℝ) / scale

theorem Rreal_posSemidef : Rreal.PosSemidef :=
  posSemidef_of_integer_gram A W c scale factor scale_positive factor_positive gram_entries

noncomputable def Breal : Matrix (Fin 64) (Fin 55) ℝ := fun i j => B i j

noncomputable def Qreal : Matrix (Fin 64) (Fin 64) ℝ :=
  Breal * Rreal * Breal.transpose

theorem Qreal_posSemidef : Qreal.PosSemidef := by
  simpa [Qreal] using Rreal_posSemidef.mul_mul_conjTranspose_same Breal

