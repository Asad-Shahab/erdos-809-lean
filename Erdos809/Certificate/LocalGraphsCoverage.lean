    ∃ r : Fin 1436, ∃ p : Fin 120, relabel (Data.representatives r) (Data.permutations p) = g := by
  exact coverage_of_indexedBlocks Data.representatives Data.permutations
    (by decide) (by decide) coverageBlocks coverageBlocks_length coverageBlocks_checked g ha

