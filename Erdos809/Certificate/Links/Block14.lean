theorem basis_entries : ∀ i j, (Block14.scale : ℤ) * Qnumerator i j =
    (Coefficients.scale : ℤ) * ∑ k, ∑ l, basis i k * Block14.A k l * basis j l := by
  intro i j
  have hs := sparseBasis_bilinear Block14.A (basisRows i) (basisRows j)
  simp only [basis_sparse] at hs
  rw [hs]
  exact of_decide_eq_true (List.all_eq_true.mp (basis_rows_checked i) j (by simp))

